<!--
  resources.qrc —— 《月满华诞，码上团圆》资源清单

  下面四张是程序内置素材，必须存在（由 tools/gen_assets.py 生成）。
  再往下三张是可选的写实素材：把对应文件放进 images/ 目录、取消注释、
  重新构建，程序就会自动改用实景图；不提供时全部走矢量绘制，一样能跑。
-->
<RCC>
    <qresource prefix="/">
        <file>images/moon.png</file>
        <file>images/mooncake.png</file>
        <file>images/spark.png</file>
        <file>images/glow.png</file>

        <!-- 软件学院夜景实拍/写实底图 -->
        <file>images/school_night.jpg</file> 
        <!-- 安阳 投影画面 -->
        <file>images/anyang_projection.jpg</file>
        <!-- 结尾祝福卡卡面 -->
        <file>images/ending_card.png</file>
    </qresource>
</RCC>
